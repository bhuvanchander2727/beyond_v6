# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment and sensitive secrets
.env
.env.*
!.env.example

# SQLite database and temporary files (protects customer orders, PII & runtime state)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local backups and scratch test artifacts
backups/
scratch/

# User uploads (preserve directory structure via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs and npm debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# Editor and IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
